'use client'

import { useState, useMemo, useRef } from 'react'
import { useRouter } from 'next/navigation'
import PageShell from '@/components/ui/page-shell'
import SectionCard from '@/components/ui/section-card'
import ActionButton from '@/components/ui/action-button'

interface SavedScript {
  id: string
  title: string
  leadType: string
  priceRange: '0-150k' | '150k-300k' | '300k-500k' | '500k+'
  priceRangeLabel: string
  content: string
  source: 'Generated' | 'Uploaded' | 'Custom'
  createdAt: string
}

const INITIAL_SCRIPTS: SavedScript[] = [
  {
    id: '1',
    title: 'Low-Tier Entry Level Cash Pitch',
    leadType: 'cold-call-absentee',
    priceRange: '0-150k',
    priceRangeLabel: '$0 - $150k Deals',
    content: `AGENT: Hi [Seller Name], I’m calling about your property on [Street Name]. We’re actively buying single-family homes under $150k in cash with zero seller closing costs or agent fees. If we can close in 10 days as-is, what is the rock-bottom price you'd consider?`,
    source: 'Custom',
    createdAt: '2026-08-01'
  },
  {
    id: '2',
    title: 'Mid-Market Absentee Seller Flow',
    leadType: 'cold-call-absentee',
    priceRange: '150k-300k',
    priceRangeLabel: '$150k - $300k Deals',
    content: `AGENT: Hi [Seller Name], I noticed your property at [Property Address]. Based on recent sales in St. Petersburg in the $200k-$300k range, we can present a quick as-is cash offer without you having to fix up a single thing. Are you open to receiving an offer this week?`,
    source: 'Generated',
    createdAt: '2026-08-05'
  },
  {
    id: '3',
    title: 'High-Equity Luxury Wholesale / Sub-To Pitch',
    leadType: 'follow-up',
    priceRange: '500k+',
    priceRangeLabel: '$500k+ Deals',
    content: `AGENT: Hello [Seller Name], given the $500k+ value of your property on [Street Name], an outright deep discount cash offer might not make sense. However, if we structure a flexible creative finance or novation agreement to net you closer to full retail value, would you be open to exploring that?`,
    source: 'Uploaded',
    createdAt: '2026-08-10'
  }
]

export default function ScriptGeneratorPage() {
  const router = useRouter()
  const fileInputRef = useRef<HTMLInputElement>(null)

  // Drawer and Library States
  const [isDrawerOpen, setIsDrawerOpen] = useState(false)
  const [savedScripts, setSavedScripts] = useState<SavedScript[]>(INITIAL_SCRIPTS)
  
  // Library Filter States
  const [filterPriceRange, setFilterPriceRange] = useState<string>('ALL')
  const [filterLeadType, setFilterLeadType] = useState<string>('ALL')
  const [searchQuery, setSearchQuery] = useState<string>('')

  // Active Generator & Editor States
  const [scriptTitle, setScriptTitle] = useState('New Custom Pitch')
  const [leadType, setLeadType] = useState('cold-call-absentee')
  const [priceRange, setPriceRange] = useState<'0-150k' | '150k-300k' | '300k-500k' | '500k+'>('150k-300k')
  const [sellerMotivation, setSellerMotivation] = useState('distressed-timeline')
  const [customNotes, setCustomNotes] = useState('Property needs roof repairs and full cosmetic updates.')
  const [generatedScript, setGeneratedScript] = useState(`AGENT: Hi, is this [Seller Name]? I'm reaching out regarding your property at [Property Address]. I noticed it might be sitting vacant or you might be looking to offload it without dealing with agents or open houses. Are you open to a cash offer?\n\nSELLER: I might be, but what are you offering?\n\nAGENT: We specialize in buying properties completely as-is with zero closing costs or commissions, and we can close on whatever timeline works best for you—whether that's 14 days or 30 days. Based on similar sales in St. Petersburg, we can present a clean cash number today. What's the biggest headache you're facing with the property right now?`)

  const [isGenerating, setIsGenerating] = useState(false)
  const [isUploading, setIsUploading] = useState(false)

  // Filtered library list
  const filteredLibrary = useMemo(() => {
    return savedScripts.filter((item) => {
      if (filterPriceRange !== 'ALL' && item.priceRange !== filterPriceRange) return false
      if (filterLeadType !== 'ALL' && item.leadType !== filterLeadType) return false
      if (searchQuery.trim() !== '') {
        const query = searchQuery.toLowerCase()
        const matchesTitle = item.title.toLowerCase().includes(query)
        const matchesContent = item.content.toLowerCase().includes(query)
        if (!matchesTitle && !matchesContent) return false
      }
      return true
    })
  }, [savedScripts, filterPriceRange, filterLeadType, searchQuery])

  // Generator Function
  const handleGenerateScript = () => {
    setIsGenerating(true)
    setTimeout(() => {
      setIsGenerating(false)
      const rangeLabel = priceRange === '0-150k' ? '$0-$150k' : priceRange === '150k-300k' ? '$150k-$300k' : priceRange === '300k-500k' ? '$300k-$500k' : '$500k+'
      
      if (leadType === 'sms-outbound') {
        setGeneratedScript(`Hi [Seller Name], I’m looking for properties in the ${rangeLabel} range around St. Petersburg / Tampa Bay and noticed yours on [Street Name]. Are you open to a fair cash offer with no realtor fees? Reply YES if interested!`)
      } else if (leadType === 'probate-intro') {
        setGeneratedScript(`AGENT: Hello [Name], first let me express my condolences regarding your family's recent passing. We work with families in Florida liquidating probate homes valued around ${rangeLabel}. We handle clear-outs, eliminate realtor commissions, and close quickly. Have you appointed an estate representative yet?`)
      } else {
        setGeneratedScript(`AGENT: Hi [Seller Name], following up on your property at [Property Address] in the ${rangeLabel} price tier. I know you mentioned wanting a quick closing timeline. We buy completely as-is with cash, covering 100% of standard closing costs. Would an offer in the next 24 hours help you move forward?`)
      }
    }, 500)
  }

  // File Upload Handler (.txt, .md, .csv)
  const handleFileUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0]
    if (!file) return

    setIsUploading(true)
    const reader = new FileReader()

    reader.onload = (event) => {
      const text = event.target?.result as string
      if (text) {
        setGeneratedScript(text)
        setScriptTitle(file.name.replace(/\.[^/.]+$/, ''))
        alert(`Successfully imported script from file: ${file.name}`)
      }
      setIsUploading(false)
    }

    reader.onerror = () => {
      alert('Error reading uploaded script file.')
      setIsUploading(false)
    }

    reader.readAsText(file)
  }

  // Save Current Script to Library State
  const handleSaveToLibrary = () => {
    if (!generatedScript.trim()) {
      alert('Script content cannot be empty.')
      return
    }

    const priceRangeLabels = {
      '0-150k': '$0 - $150k Deals',
      '150k-300k': '$150k - $300k Deals',
      '300k-500k': '$300k - $500k Deals',
      '500k+': '$500k+ Deals'
    }

    const newScriptItem: SavedScript = {
      id: Date.now().toString(),
      title: scriptTitle || 'Untitled Script',
      leadType,
      priceRange,
      priceRangeLabel: priceRangeLabels[priceRange],
      content: generatedScript,
      source: 'Custom',
      createdAt: new Date().toISOString().split('T')[0]
    }

    setSavedScripts([newScriptItem, ...savedScripts])
    alert('Script saved to script library successfully!')
  }

  const handleCopyScript = () => {
    navigator.clipboard.writeText(generatedScript)
    alert('Script successfully copied to clipboard!')
  }

  const handleLoadScript = (script: SavedScript) => {
    setScriptTitle(script.title)
    setGeneratedScript(script.content)
    setPriceRange(script.priceRange)
    setLeadType(script.leadType)
    setIsDrawerOpen(false)
  }

  return (
    <PageShell title="Cold Call & SMS Script Generator" subtitle="Generate, upload, and organize custom acquisition scripts categorized by deal price ranges and lead channels.">
      <SectionCard>
        <div style={{ display: 'grid', gap: 20, maxWidth: 720 }}>
          
          {/* Header Actions & Upload Bar */}
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', background: 'rgba(214,166,75,0.05)', padding: '14px 18px', borderRadius: 12, border: '1px solid rgba(214,166,75,0.2)' }}>
            <div>
              <div style={{ fontSize: 13, color: '#ebc477', fontWeight: 600 }}>Script Library & File Upload</div>
              <div style={{ fontSize: 11, color: '#aaa', marginTop: 2 }}>{savedScripts.length} saved scripts indexed across target price ranges</div>
            </div>
            <div style={{ display: 'flex', gap: 10 }}>
              <input 
                type="file" 
                ref={fileInputRef} 
                onChange={handleFileUpload} 
                accept=".txt,.md,.doc,.docx" 
                style={{ display: 'none' }} 
              />
              <ActionButton tone="ghost" onClick={() => fileInputRef.current?.click()}>
                {isUploading ? 'Reading File...' : 'Upload Script File 📁'}
              </ActionButton>
              <ActionButton tone="gold" onClick={() => setIsDrawerOpen(true)}>
                Open Saved Library 📚
              </ActionButton>
            </div>
          </div>

          <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 16 }}>
            <div style={{ display: 'grid', gap: 6 }}>
              <label style={{ fontSize: 12, color: '#ebc477', fontWeight: 600 }}>Script Title / Label</label>
              <input 
                type="text" 
                value={scriptTitle} 
                onChange={(e) => setScriptTitle(e.target.value)} 
                style={{ padding: '12px 14px', borderRadius: 8, background: 'rgba(0,0,0,0.6)', border: '1px solid rgba(214,166,75,0.3)', color: '#fff', fontSize: 14 }} 
              />
            </div>
            <div style={{ display: 'grid', gap: 6 }}>
              <label style={{ fontSize: 12, color: '#ebc477', fontWeight: 600 }}>Target Property Price Range</label>
              <select value={priceRange} onChange={(e) => setPriceRange(e.target.value as any)} style={{ padding: '12px 14px', borderRadius: 8, background: 'rgba(0,0,0,0.6)', border: '1px solid rgba(214,166,75,0.3)', color: '#fff', fontSize: 14 }}>
                <option value="0-150k">$0 - $150k Deals (Low Tier / Mobile / Land)</option>
                <option value="150k-300k">$150k - $300k Deals (Mid Tier Core Wholesale)</option>
                <option value="300k-500k">$300k - $500k Deals (Upper Mid Market)</option>
                <option value="500k+">$500k+ Deals (High Tier / Creative Finance)</option>
              </select>
            </div>
          </div>

          <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 16 }}>
            <div style={{ display: 'grid', gap: 6 }}>
              <label style={{ fontSize: 12, color: '#ebc477', fontWeight: 600 }}>Channel / Lead Type</label>
              <select value={leadType} onChange={(e) => setLeadType(e.target.value)} style={{ padding: '12px 14px', borderRadius: 8, background: 'rgba(0,0,0,0.6)', border: '1px solid rgba(214,166,75,0.3)', color: '#fff', fontSize: 14 }}>
                <option value="cold-call-absentee">Cold Call - Absentee Owner</option>
                <option value="sms-outbound">SMS Outbound Broadcast</option>
                <option value="probate-intro">Probate / Inherited Property</option>
                <option value="follow-up">Warm Follow-Up / Negotiation</option>
              </select>
            </div>
            <div style={{ display: 'grid', gap: 6 }}>
              <label style={{ fontSize: 12, color: '#ebc477', fontWeight: 600 }}>Motivation Hook</label>
              <select value={sellerMotivation} onChange={(e) => setSellerMotivation(e.target.value)} style={{ padding: '12px 14px', borderRadius: 8, background: 'rgba(0,0,0,0.6)', border: '1px solid rgba(214,166,75,0.3)', color: '#fff', fontSize: 14 }}>
                <option value="distressed-timeline">Distressed Timeline / Speed</option>
                <option value="repair-fatigue">High Repair Costs / Maintenance Fatigue</option>
                <option value="financial-burden">Financial Pressure / Tax Liens</option>
              </select>
            </div>
          </div>

          <div style={{ display: 'grid', gap: 6 }}>
            <label style={{ fontSize: 12, color: '#ebc477', fontWeight: 600 }}>Property / Context Notes</label>
            <input 
              type="text" 
              value={customNotes} 
              onChange={(e) => setCustomNotes(e.target.value)} 
              style={{ padding: '12px 14px', borderRadius: 8, background: 'rgba(0,0,0,0.6)', border: '1px solid rgba(214,166,75,0.3)', color: '#fff', fontSize: 14 }} 
            />
          </div>

          <ActionButton tone="gold" onClick={handleGenerateScript}>
            {isGenerating ? 'Synthesizing Custom Script...' : 'Generate AI Script ⚡'}
          </ActionButton>

          <div style={{ display: 'grid', gap: 8 }}>
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
              <label style={{ fontSize: 12, color: '#ebc477', fontWeight: 600 }}>Active Script Workspace</label>
              <div style={{ display: 'flex', gap: 8 }}>
                <ActionButton tone="ghost" onClick={handleCopyScript}>Copy 📋</ActionButton>
                <ActionButton tone="gold" onClick={handleSaveToLibrary}>Save to Library 💾</ActionButton>
              </div>
            </div>
            <textarea 
              rows={9} 
              value={generatedScript} 
              onChange={(e) => setGeneratedScript(e.target.value)} 
              style={{ padding: '14px', borderRadius: 8, background: 'rgba(0,0,0,0.7)', border: '1px solid rgba(214,166,75,0.3)', color: '#fff', fontSize: 13, lineHeight: 1.6, resize: 'vertical' }} 
            />
          </div>

          <div style={{ display: 'flex', justifyContent: 'flex-end', gap: 12, marginTop: 12 }}>
            <ActionButton tone="ghost" onClick={() => router.push('/tools')}>Back to Tools</ActionButton>
          </div>

        </div>
      </SectionCard>

      {/* Script Library & Price Range Filter Slide-out Drawer */}
      {isDrawerOpen && (
        <div style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.85)', zIndex: 999, display: 'flex', justifyContent: 'flex-end' }}>
          <div style={{ width: '100%', maxWidth: 640, background: '#0a0a0a', borderLeft: '1px solid rgba(214,166,75,0.35)', padding: 32, display: 'grid', gridTemplateRows: 'auto 1fr auto', gap: 24, overflowY: 'auto' }}>
            
            {/* Drawer Header */}
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', borderBottom: '1px solid rgba(214,166,75,0.2)', paddingBottom: 16 }}>
              <div>
                <h2 style={{ fontSize: 20, color: '#ebc477', fontWeight: 700, margin: 0 }}>Script Vault & Price Range Filters</h2>
                <p style={{ fontSize: 13, color: '#aaa', margin: '4px 0 0' }}>Search and load categorized pitch templates</p>
              </div>
              <ActionButton tone="ghost" onClick={() => setIsDrawerOpen(false)}>Close ✕</ActionButton>
            </div>

            {/* Filter Controls Panel */}
            <div style={{ display: 'grid', gap: 16 }}>
              <div style={{ background: 'rgba(214,166,75,0.04)', border: '1px solid rgba(214,166,75,0.2)', borderRadius: 12, padding: 18, display: 'grid', gap: 14 }}>
                <div style={{ fontSize: 13, color: '#ebc477', fontWeight: 600 }}>Filter Library Options</div>

                <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 12 }}>
                  <div style={{ display: 'grid', gap: 4 }}>
                    <label style={{ fontSize: 11, color: '#aaa' }}>Target Price Range</label>
                    <select value={filterPriceRange} onChange={(e) => setFilterPriceRange(e.target.value)} style={{ padding: '8px 10px', borderRadius: 6, background: '#000', border: '1px solid rgba(214,166,75,0.3)', color: '#fff', fontSize: 13 }}>
                      <option value="ALL">All Price Ranges</option>
                      <option value="0-150k">$0 - $150k Deals</option>
                      <option value="150k-300k">$150k - $300k Deals</option>
                      <option value="300k-500k">$300k - $500k Deals</option>
                      <option value="500k+">$500k+ Deals</option>
                    </select>
                  </div>

                  <div style={{ display: 'grid', gap: 4 }}>
                    <label style={{ fontSize: 11, color: '#aaa' }}>Channel / Lead Type</label>
                    <select value={filterLeadType} onChange={(e) => setFilterLeadType(e.target.value)} style={{ padding: '8px 10px', borderRadius: 6, background: '#000', border: '1px solid rgba(214,166,75,0.3)', color: '#fff', fontSize: 13 }}>
                      <option value="ALL">All Lead Types</option>
                      <option value="cold-call-absentee">Cold Call - Absentee Owner</option>
                      <option value="sms-outbound">SMS Outbound Broadcast</option>
                      <option value="probate-intro">Probate / Inherited</option>
                      <option value="follow-up">Warm Follow-Up</option>
                    </select>
                  </div>
                </div>

                <div style={{ display: 'grid', gap: 4 }}>
                  <label style={{ fontSize: 11, color: '#aaa' }}>Search Keyword</label>
                  <input 
                    type="text" 
                    placeholder="Search titles or script keywords..." 
                    value={searchQuery} 
                    onChange={(e) => setSearchQuery(e.target.value)} 
                    style={{ padding: '8px 10px', borderRadius: 6, background: '#000', border: '1px solid rgba(214,166,75,0.3)', color: '#fff', fontSize: 13 }} 
                  />
                </div>
              </div>

              {/* Script List */}
              <div style={{ display: 'grid', gap: 12 }}>
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                  <span style={{ fontSize: 13, color: '#fff', fontWeight: 600 }}>Saved Scripts ({filteredLibrary.length})</span>
                  <span style={{ fontSize: 11, color: '#888' }}>Click to load into editor</span>
                </div>

                {filteredLibrary.length === 0 ? (
                  <div style={{ padding: 24, textAlign: 'center', color: '#777', fontSize: 13, background: 'rgba(0,0,0,0.3)', borderRadius: 8 }}>
                    No scripts matched the selected price range or lead filter criteria.
                  </div>
                ) : (
                  filteredLibrary.map((script) => (
                    <div 
                      key={script.id} 
                      onClick={() => handleLoadScript(script)}
                      style={{ padding: 16, borderRadius: 10, background: 'rgba(0,0,0,0.6)', border: '1px solid rgba(214,166,75,0.25)', cursor: 'pointer', display: 'grid', gap: 8, transition: 'all 0.2s' }}
                    >
                      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start' }}>
                        <div style={{ fontSize: 14, color: '#ebc477', fontWeight: 700 }}>{script.title}</div>
                        <span style={{ padding: '2px 8px', borderRadius: 4, background: 'rgba(214,166,75,0.15)', color: '#fff', fontSize: 11, fontWeight: 600 }}>
                          {script.priceRangeLabel}
                        </span>
                      </div>
                      <div style={{ fontSize: 12, color: '#ccc', lineHeight: 1.5, display: '-webkit-box', WebkitLineClamp: 3, WebkitBoxOrient: 'vertical', overflow: 'hidden' }}>
                        {script.content}
                      </div>
                      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', fontSize: 10, color: '#888', borderTop: '1px solid rgba(255,255,255,0.05)', paddingTop: 6 }}>
                        <span>Channel: {script.leadType}</span>
                        <span>Source: {script.source} • Added {script.createdAt}</span>
                      </div>
                    </div>
                  ))
                )}
              </div>
            </div>

            {/* Drawer Footer */}
            <div style={{ borderTop: '1px solid rgba(214,166,75,0.2)', paddingTop: 16, display: 'flex', justifyContent: 'flex-end' }}>
              <ActionButton tone="ghost" onClick={() => setIsDrawerOpen(false)}>Close Vault</ActionButton>
            </div>

          </div>
        </div>
      )}
    </PageShell>
  )
}
