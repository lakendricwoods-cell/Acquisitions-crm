'use client'

import { useState } from 'react'
import { useRouter } from 'next/navigation'
import PageShell from '@/components/ui/page-shell'
import SectionCard from '@/components/ui/section-card'
import ActionButton from '@/components/ui/action-button'

export default function ClosingCostCalculatorPage() {
  const router = useRouter()
  const [purchasePrice, setPurchasePrice] = useState('200000')
  const [holdingDays, setHoldingDays] = useState('30')
  const [titleFees, setTitleFees] = useState('2500')
  const [transferTaxRate, setTransferTaxRate] = useState('0.007') // Florida documentary stamp tax baseline estimate

  const priceNum = parseFloat(purchasePrice) || 0
  const transferTaxes = priceNum * (parseFloat(transferTaxRate) || 0)
  const titleNum = parseFloat(titleFees) || 0
  const estimatedClosingTotal = transferTaxes + titleNum

  return (
    <PageShell title="Closing Cost Calculator" subtitle="Estimate title fees, transfer taxes, holding costs, and seller/buyer closing expenses.">
      <SectionCard>
        <div style={{ display: 'grid', gap: 16, maxWidth: 600 }}>
          <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 16 }}>
            <div style={{ display: 'grid', gap: 6 }}>
              <label style={{ fontSize: 12, color: '#ebc477', fontWeight: 600 }}>Purchase / Contract Price</label>
              <input type="number" value={purchasePrice} onChange={(e) => setPurchasePrice(e.target.value)} style={{ padding: '10px 12px', borderRadius: 8, background: 'rgba(0,0,0,0.6)', border: '1px solid rgba(214,166,75,0.3)', color: '#fff' }} />
            </div>
            <div style={{ display: 'grid', gap: 6 }}>
              <label style={{ fontSize: 12, color: '#ebc477', fontWeight: 600 }}>Estimated Holding (Days)</label>
              <input type="number" value={holdingDays} onChange={(e) => setHoldingDays(e.target.value)} style={{ padding: '10px 12px', borderRadius: 8, background: 'rgba(0,0,0,0.6)', border: '1px solid rgba(214,166,75,0.3)', color: '#fff' }} />
            </div>
            <div style={{ display: 'grid', gap: 6 }}>
              <label style={{ fontSize: 12, color: '#ebc477', fontWeight: 600 }}>Title & Escrow Fees</label>
              <input type="number" value={titleFees} onChange={(e) => setTitleFees(e.target.value)} style={{ padding: '10px 12px', borderRadius: 8, background: 'rgba(0,0,0,0.6)', border: '1px solid rgba(214,166,75,0.3)', color: '#fff' }} />
            </div>
            <div style={{ display: 'grid', gap: 6 }}>
              <label style={{ fontSize: 12, color: '#ebc477', fontWeight: 600 }}>Doc Stamps / Transfer Tax Rate</label>
              <input type="number" step="0.001" value={transferTaxRate} onChange={(e) => setTransferTaxRate(e.target.value)} style={{ padding: '10px 12px', borderRadius: 8, background: 'rgba(0,0,0,0.6)', border: '1px solid rgba(214,166,75,0.3)', color: '#fff' }} />
            </div>
          </div>

          <div style={{ padding: 16, borderRadius: 10, background: 'rgba(214,166,75,0.1)', border: '1px solid rgba(214,166,75,0.3)', display: 'grid', gap: 8 }}>
            <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: 13, color: '#aaa' }}>
              <span>Transfer Taxes (Doc Stamps):</span>
              <span style={{ color: '#fff' }}>${transferTaxes.toLocaleString(undefined, { maximumFractionDigits: 2 })}</span>
            </div>
            <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: 13, color: '#aaa' }}>
              <span>Title & Settlement Fees:</span>
              <span style={{ color: '#fff' }}>${titleNum.toLocaleString()}</span>
            </div>
            <div style={{ borderTop: '1px solid rgba(214,166,75,0.2)', paddingTop: 8, display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
              <span style={{ fontSize: 14, color: '#fff', fontWeight: 600 }}>Total Closing Expenses:</span>
              <span style={{ fontSize: 20, color: '#ebc477', fontWeight: 800 }}>${estimatedClosingTotal.toLocaleString(undefined, { maximumFractionDigits: 2 })}</span>
            </div>
          </div>

          <div style={{ display: 'flex', justifyContent: 'flex-end', gap: 12, marginTop: 8 }}>
            <ActionButton tone="ghost" onClick={() => router.push('/tools')}>Back to Tools</ActionButton>
            <ActionButton tone="gold" onClick={() => alert('Closing cost breakdown saved successfully!')}>Save Calculation</ActionButton>
          </div>
        </div>
      </SectionCard>
    </PageShell>
  )
}
