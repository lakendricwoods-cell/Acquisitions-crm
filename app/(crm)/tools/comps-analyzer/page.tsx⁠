'use client'

import Link from 'next/link'
import { useEffect, useMemo, useState, type CSSProperties } from 'react'
import { useRouter } from 'next/navigation'
import ActionButton from '@/components/ui/action-button'
import PageShell from '@/components/ui/page-shell'
import SectionCard from '@/components/ui/section-card'
import StatPill from '@/components/ui/stat-pill'
import { supabase } from '@/lib/supabase'

type CompRecord = {
  id: string
  property_address?: string | null
  city?: string | null
  state?: string | null
  zip?: string | null
  sale_price?: number | null
  square_feet?: number | null
  bedrooms?: number | null
  bathrooms?: number | null
  distance_miles?: number | null
  sale_date?: string | null
  created_at?: string | null
}

function money(value: number | null | undefined) {
  if (value === null || value === undefined || Number.isNaN(value)) return '—'
  return new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    maximumFractionDigits: 0,
  }).format(value)
}

export default function CompsAnalyzerPage() {
  const router = useRouter()
  const [comps, setComps] = useState<CompRecord[]>([])
  const [loading, setLoading] = useState(true)
  const [targetArv, setTargetArv] = useState<number>(320000)
  const [targetSqft, setTargetSqft] = useState<number>(1450)
  const [radiusMiles, setRadiusMiles] = useState<number>(1.0)
  const [newCompAddress, setNewCompAddress] = useState('')
  const [newCompPrice, setNewCompPrice] = useState('')
  const [newCompSqft, setNewCompSqft] = useState('')

  useEffect(() => {
    async function loadComps() {
      setLoading(true)
      const { data, error } = await supabase
        .from('comparables')
        .select('*')
        .order('created_at', { ascending: false })

      if (error) {
        console.error('Failed to load comps:', error)
        setComps([])
      } else {
        setComps((data as CompRecord[]) || [])
      }
      setLoading(false)
    }

    void loadComps()
  }, [])

  const analytics = useMemo(() => {
    if (comps.length === 0) return { avgPricePerSqft: 0, estimatedArv: targetArv, compCount: 0 }
    
    const validComps = comps.filter((c) => (c.sale_price ?? 0) > 0 && (c.square_feet ?? 0) > 0)
    if (validComps.length === 0) return { avgPricePerSqft: 0, estimatedArv: targetArv, compCount: 0 }

    const totalPpsf = validComps.reduce((acc, c) => acc + (c.sale_price! / c.square_feet!), 0)
    const avgPpsf = totalPpsf / validComps.length
    const calculatedArv = Math.round(avgPpsf * targetSqft)

    return {
      avgPricePerSqft: Math.round(avgPpsf),
      estimatedArv: calculatedArv > 0 ? calculatedArv : targetArv,
      compCount: validComps.length,
    }
  }, [comps, targetSqft, targetArv])

  async function handleAddComp(e: React.FormEvent) {
    e.preventDefault()
    if (!newCompAddress || !newCompPrice) return

    const payload = {
      property_address: newCompAddress,
      sale_price: Number(newCompPrice),
      square_feet: newCompSqft ? Number(newCompSqft) : null,
    }

    const { data, error } = await supabase.from('comparables').insert([payload]).select().single()

    if (error) {
      alert(`Failed to add comparable: ${error.message}`)
      return
    }

    if (data) {
      setComps((curr) => [data as CompRecord, ...curr])
      setNewCompAddress('')
      setNewCompPrice('')
      setNewCompSqft('')
    }
  }

  async function handleDeleteComp(id: string) {
    if (!confirm('Are you sure you want to delete this comparable?')) return

    const { error } = await supabase.from('comparables').delete().eq('id', id)
    if (error) {
      alert(`Failed to delete: ${error.message}`)
      return
    }

    setComps((curr) => curr.filter((c) => c.id !== id))
  }

  return (
    <PageShell
      title="Comparable Sales (Comps) Analyzer"
      subtitle="Analyze localized market values, price per square foot metrics, and derived ARV models."
      actions={
        <>
          <StatPill label="Active Comps" value={analytics.compCount} />
          <StatPill label="Avg $/SqFt" value={`$${analytics.avgPricePerSqft}`} />
          <StatPill label="Derived ARV" value={money(analytics.estimatedArv)} />
          <Link href="/leads">
            <ActionButton compact tone="gold">Back to Leads</ActionButton>
          </Link>
        </>
      }
    >
      <div style={pageGridStyle}>
        <div style={leftRailStyle}>
          <SectionCard
            title="Subject Property Parameters"
            subtitle="Configure target attributes to automatically calculate localized market ARV."
          >
            <div style={formGridStyle}>
              <div style={inputGroupStyle}>
                <label style={labelStyle}>Target Square Footage</label>
                <input
                  type="number"
                  value={targetSqft}
                  onChange={(e) => setTargetSqft(Number(e.target.value))}
                  style={inputStyle}
                />
              </div>

              <div style={inputGroupStyle}>
                <label style={labelStyle}>Target Baseline ARV ($)</label>
                <input
                  type="number"
                  value={targetArv}
                  onChange={(e) => setTargetArv(Number(e.target.value))}
                  style={inputStyle}
                />
              </div>

              <div style={inputGroupStyle}>
                <label style={labelStyle}>Search Radius (Miles)</label>
                <input
                  type="number"
                  step="0.1"
                  value={radiusMiles}
                  onChange={(e) => setRadiusMiles(Number(e.target.value))}
                  style={inputStyle}
                />
              </div>
            </div>
          </SectionCard>

          <SectionCard
            title="Add Manual Comparable Property"
            subtitle="Record recent nearby closed sales to feed the valuation matrix."
          >
            <form onSubmit={handleAddComp} style={formGridStyle}>
              <div style={inputGroupStyle}>
                <label style={labelStyle}>Comp Property Address</label>
                <input
                  type="text"
                  placeholder="e.g., 1420 22nd Ave N, St. Petersburg, FL"
                  value={newCompAddress}
                  onChange={(e) => setNewCompAddress(e.target.value)}
                  style={inputStyle}
                />
              </div>

              <div style={inlineInputGridStyle}>
                <div style={inputGroupStyle}>
                  <label style={labelStyle}>Sale Price ($)</label>
                  <input
                    type="number"
                    placeholder="295000"
                    value={newCompPrice}
                    onChange={(e) => setNewCompPrice(e.target.value)}
                    style={inputStyle}
                  />
                </div>
                <div style={inputGroupStyle}>
                  <label style={labelStyle}>Square Feet</label>
                  <input
                    type="number"
                    placeholder="1350"
                    value={newCompSqft}
                    onChange={(e) => setNewCompSqft(e.target.value)}
                    style={inputStyle}
                  />
                </div>
              </div>

              <div>
                <ActionButton tone="gold">Add Comparable to Model</ActionButton>
              </div>
            </form>
          </SectionCard>
        </div>

        <div style={rightRailStyle}>
          <SectionCard
            title="Comparable Market Feed"
            subtitle="Active sales currently influencing the underwriting valuation engine."
          >
            {loading ? (
              <div style={mutedStyle}>Loading comparable sales data...</div>
            ) : comps.length === 0 ? (
              <div style={mutedStyle}>No comps added yet. Use the form to seed your first property comp.</div>
            ) : (
              <div style={compListStyle}>
                {comps.map((comp) => {
                  const ppsf =
                    comp.sale_price && comp.square_feet && comp.square_feet > 0
                      ? Math.round(comp.sale_price / comp.square_feet)
                      : null

                  return (
                    <div key={comp.id} style={compCardStyle}>
                      <div style={compHeaderStyle}>
                        <div style={compAddressStyle}>{comp.property_address || 'Unnamed Property'}</div>
                        <button
                          type="button"
                          onClick={() => handleDeleteComp(comp.id)}
                          style={deleteButtonStyle}
                          title="Delete Comp"
                        >
                          ✕
                        </button>
                      </div>

                      <div style={compMetricsGridStyle}>
                        <div style={compMetricItem}>
                          <span style={miniKeyStyle}>Sale Price</span>
                          <span style={compMetricValue}>{money(comp.sale_price)}</span>
                        </div>
                        <div style={compMetricItem}>
                          <span style={miniKeyStyle}>Square Feet</span>
                          <span style={compMetricValue}>{comp.square_feet ? `${comp.square_feet} sqft` : '—'}</span>
                        </div>
                        <div style={compMetricItem}>
                          <span style={miniKeyStyle}>Price / SqFt</span>
                          <span style={compMetricValue}>{ppsf ? `$${ppsf}` : '—'}</span>
                        </div>
                      </div>
                    </div>
                  )
                })}
              </div>
            )}
          </SectionCard>
        </div>
      </div>
    </PageShell>
  )
}

