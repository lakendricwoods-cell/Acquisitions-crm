'use client'

import { useState, useMemo } from 'react'
import { useRouter } from 'next/navigation'
import PageShell from '@/components/ui/page-shell'
import SectionCard from '@/components/ui/section-card'
import ActionButton from '@/components/ui/action-button'

interface CompProperty {
  id: string
  address: string
  distance: number
  salePrice: number
  beds: number
  baths: number
  sqft: number
  yearBuilt: number
  daysOnMarket: number
  source: 'Zillow' | 'Propwire' | 'Google MLS'
  matchScore: number
}

const MOCK_DATABASE_COMPS: CompProperty[] = [
  { id: '1', address: '1255 19th Ave N, St. Petersburg, FL', distance: 0.12, salePrice: 295000, beds: 3, baths: 2, sqft: 1420, yearBuilt: 1978, daysOnMarket: 14, source: 'Propwire', matchScore: 98 },
  { id: '2', address: '1310 17th Ave N, St. Petersburg, FL', distance: 0.24, salePrice: 310000, beds: 3, baths: 2, sqft: 1500, yearBuilt: 1982, daysOnMarket: 29, source: 'Zillow', matchScore: 94 },
  { id: '3', address: '1150 20th Ave N, St. Petersburg, FL', distance: 0.38, salePrice: 280000, beds: 3, baths: 1.5, sqft: 1350, yearBuilt: 1975, daysOnMarket: 45, source: 'Google MLS', matchScore: 91 },
  { id: '4', address: '1402 22nd Ave N, St. Petersburg, FL', distance: 0.45, salePrice: 325000, beds: 4, baths: 2, sqft: 1680, yearBuilt: 1985, daysOnMarket: 8, source: 'Propwire', matchScore: 86 },
  { id: '5', address: '1090 15th Ave N, St. Petersburg, FL', distance: 0.52, salePrice: 275000, beds: 3, baths: 2, sqft: 1300, yearBuilt: 1970, daysOnMarket: 62, source: 'Zillow', matchScore: 83 },
]

export default function CompsAnalyzerPage() {
  const router = useRouter()
  const [isDrawerOpen, setIsDrawerOpen] = useState(false)
  const [selectedProperty, setSelectedProperty] = useState('1247 18th Ave N, St. Petersburg, FL')
  
  // Filter States
  const [radius, setRadius] = useState('0.5')
  const [minBeds, setMinBeds] = useState('3')
  const [minBaths, setMinBaths] = useState('1.5')
  const [maxSqftDiff, setMaxSqftDiff] = useState('400')
  const [maxDaysOnMarket, setMaxDaysOnMarket] = useState('90')
  const [selectedSource, setSelectedSource] = useState<string>('ALL')

  const [isLoadingComps, setIsLoadingComps] = useState(false)
  const [activeComps, setActiveComps] = useState<CompProperty[]>(MOCK_DATABASE_COMPS)

  // Real-time dynamic filtering logic mimicking API payload response
  const filteredComps = useMemo(() => {
    const rLimit = parseFloat(radius) || 1.0
    const bedLimit = parseInt(minBeds) || 0
    const bathLimit = parseFloat(minBaths) || 0
    const sqftLimit = parseInt(maxSqftDiff) || 500
    const domLimit = parseInt(maxDaysOnMarket) || 365

    // Assuming subject property baseline specs: 3 Bed, 2 Bath, 1400 SqFt
    const subjectBeds = 3
    const subjectSqft = 1400

    return activeComps.filter((comp) => {
      if (comp.distance > rLimit) return false
      if (comp.beds < bedLimit) return false
      if (comp.baths < bathLimit) return false
      if (Math.abs(comp.sqft - subjectSqft) > sqftLimit) return false
      if (comp.daysOnMarket > domLimit) return false
      if (selectedSource !== 'ALL' && comp.source !== selectedSource) return false
      return true
    })
  }, [activeComps, radius, minBeds, minBaths, maxSqftDiff, maxDaysOnMarket, selectedSource])

  const averageArv = filteredComps.length > 0 
    ? filteredComps.reduce((acc, curr) => acc + curr.salePrice, 0) / filteredComps.length 
    : 0

  const averagePricePerSqft = filteredComps.length > 0
    ? filteredComps.reduce((acc, curr) => acc + (curr.salePrice / curr.sqft), 0) / filteredComps.length
    : 0

  const handleLiveQuery = () => {
    setIsLoadingComps(true)
    setTimeout(() => {
      // Simulating external endpoint aggregation (Propwire / Zillow / Google Maps API handshake)
      setIsLoadingComps(false)
    }, 750)
  }

  return (
    <PageShell title="Comparable Sales Analyzer" subtitle="Underwrite After Repair Value (ARV) with live data streams across Propwire, Zillow, and public records.">
      <SectionCard>
        <div style={{ display: 'grid', gap: 20, maxWidth: 680 }}>
          
          <div style={{ display: 'grid', gap: 6 }}>
            <label style={{ fontSize: 12, color: '#ebc477', fontWeight: 600 }}>Subject Asset Address</label>
            <div style={{ display: 'flex', gap: 8 }}>
              <input 
                type="text" 
                value={selectedProperty} 
                onChange={(e) => setSelectedProperty(e.target.value)} 
                style={{ flex: 1, padding: '12px 14px', borderRadius: 8, background: 'rgba(0,0,0,0.6)', border: '1px solid rgba(214,166,75,0.3)', color: '#fff', fontSize: 14 }} 
              />
              <ActionButton tone="gold" onClick={() => setIsDrawerOpen(true)}>Open Comps Terminal ↗</ActionButton>
            </div>
          </div>

          <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 16 }}>
            <div style={{ padding: 18, borderRadius: 12, background: 'rgba(214,166,75,0.06)', border: '1px solid rgba(214,166,75,0.25)', display: 'grid', gap: 6 }}>
              <span style={{ fontSize: 13, color: '#aaa' }}>Active Filtered ARV</span>
              <span style={{ fontSize: 24, color: '#ebc477', fontWeight: 800 }}>${averageArv.toLocaleString(undefined, { maximumFractionDigits: 0 })}</span>
              <span style={{ fontSize: 11, color: '#888' }}>Based on {filteredComps.length} active matching comps</span>
            </div>
            <div style={{ padding: 18, borderRadius: 12, background: 'rgba(214,166,75,0.06)', border: '1px solid rgba(214,166,75,0.25)', display: 'grid', gap: 6 }}>
              <span style={{ fontSize: 13, color: '#aaa' }}>Avg Price / SqFt</span>
              <span style={{ fontSize: 24, color: '#fff', fontWeight: 800 }}>${averagePricePerSqft.toFixed(2)} / sqft</span>
              <span style={{ fontSize: 11, color: '#888' }}>Localized market baseline</span>
            </div>
          </div>

          <div style={{ display: 'flex', justifyContent: 'flex-end', gap: 12, marginTop: 12 }}>
            <ActionButton tone="ghost" onClick={() => router.push('/tools')}>Back to Tools</ActionButton>
            <ActionButton tone="gold" onClick={() => alert('Comps snapshot locked and saved successfully!')}>Save Comps Analysis</ActionButton>
          </div>

        </div>
      </SectionCard>

      {/* Advanced Comps Workspace Slide-out Drawer */}
      {isDrawerOpen && (
        <div style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.85)', zIndex: 999, display: 'flex', justifyContent: 'flex-end' }}>
          <div style={{ width: '100%', maxWidth: 640, background: '#0a0a0a', borderLeft: '1px solid rgba(214,166,75,0.35)', padding: 32, display: 'grid', gridTemplateRows: 'auto 1fr auto', gap: 24, overflowY: 'auto' }}>
            
            {/* Header */}
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', borderBottom: '1px solid rgba(214,166,75,0.2)', paddingBottom: 16 }}>
              <div>
                <h2 style={{ fontSize: 20, color: '#ebc477', fontWeight: 700, margin: 0 }}>Live Comps Underwriting Workspace</h2>
                <p style={{ fontSize: 13, color: '#aaa', margin: '4px 0 0' }}>Target: <span style={{ color: '#fff' }}>{selectedProperty}</span></p>
              </div>
              <ActionButton tone="ghost" onClick={() => setIsDrawerOpen(false)}>Close ✕</ActionButton>
            </div>

            {/* Filter Controls Panel */}
            <div style={{ display: 'grid', gap: 16 }}>
              <div style={{ background: 'rgba(214,166,75,0.04)', border: '1px solid rgba(214,166,75,0.2)', borderRadius: 12, padding: 18, display: 'grid', gap: 14 }}>
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                  <span style={{ fontSize: 13, color: '#ebc477', fontWeight: 600 }}>Spec & Radius Query Filters</span>
                  <span style={{ fontSize: 11, color: '#888' }}>Propwire / Zillow / Google Maps Engine</span>
                </div>

                <div style={{ display: 'grid', gridTemplateColumns: 'repeat(3, 1fr)', gap: 12 }}>
                  <div style={{ display: 'grid', gap: 4 }}>
                    <label style={{ fontSize: 11, color: '#aaa' }}>Radius (Miles)</label>
                    <input type="number" step="0.1" value={radius} onChange={(e) => setRadius(e.target.value)} style={{ padding: '8px 10px', borderRadius: 6, background: '#000', border: '1px solid rgba(214,166,75,0.3)', color: '#fff', fontSize: 13 }} />
                  </div>
                  <div style={{ display: 'grid', gap: 4 }}>
                    <label style={{ fontSize: 11, color: '#aaa' }}>Min Beds</label>
                    <input type="number" value={minBeds} onChange={(e) => setMinBeds(e.target.value)} style={{ padding: '8px 10px', borderRadius: 6, background: '#000', border: '1px solid rgba(214,166,75,0.3)', color: '#fff', fontSize: 13 }} />
                  </div>
                  <div style={{ display: 'grid', gap: 4 }}>
                    <label style={{ fontSize: 11, color: '#aaa' }}>Min Baths</label>
                    <input type="number" step="0.5" value={minBaths} onChange={(e) => setMinBaths(e.target.value)} style={{ padding: '8px 10px', borderRadius: 6, background: '#000', border: '1px solid rgba(214,166,75,0.3)', color: '#fff', fontSize: 13 }} />
                  </div>
                  <div style={{ display: 'grid', gap: 4 }}>
                    <label style={{ fontSize: 11, color: '#aaa' }}>SqFt Variance</label>
                    <input type="number" value={maxSqftDiff} onChange={(e) => setMaxSqftDiff(e.target.value)} style={{ padding: '8px 10px', borderRadius: 6, background: '#000', border: '1px solid rgba(214,166,75,0.3)', color: '#fff', fontSize: 13 }} />
                  </div>
                  <div style={{ display: 'grid', gap: 4 }}>
                    <label style={{ fontSize: 11, color: '#aaa' }}>Max DOM</label>
                    <input type="number" value={maxDaysOnMarket} onChange={(e) => setMaxDaysOnMarket(e.target.value)} style={{ padding: '8px 10px', borderRadius: 6, background: '#000', border: '1px solid rgba(214,166,75,0.3)', color: '#fff', fontSize: 13 }} />
                  </div>
                  <div style={{ display: 'grid', gap: 4 }}>
                    <label style={{ fontSize: 11, color: '#aaa' }}>Data Source</label>
                    <select value={selectedSource} onChange={(e) => setSelectedSource(e.target.value)} style={{ padding: '8px 10px', borderRadius: 6, background: '#000', border: '1px solid rgba(214,166,75,0.3)', color: '#fff', fontSize: 13 }}>
                      <option value="ALL">All Sources</option>
                      <option value="Propwire">Propwire</option>
                      <option value="Zillow">Zillow</option>
                      <option value="Google MLS">Google MLS</option>
                    </select>
                  </div>
                </div>

                <ActionButton tone="gold" onClick={handleLiveQuery}>
                  {isLoadingComps ? 'Syncing Live Feeds...' : 'Run Real-Time Data Query'}
                </ActionButton>
              </div>

              {/* Comps List Section */}
              <div style={{ display: 'grid', gap: 10 }}>
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                  <span style={{ fontSize: 13, color: '#fff', fontWeight: 600 }}>Matching Properties ({filteredComps.length})</span>
                  <span style={{ fontSize: 11, color: '#ebc477' }}>Sorted by Match Score</span>
                </div>

                {filteredComps.length === 0 ? (
                  <div style={{ padding: 24, textAlign: 'center', color: '#777', fontSize: 13, background: 'rgba(0,0,0,0.3)', borderRadius: 8 }}>
                    No comparable properties match the current active filter parameters. Expand your search radius or variance limits.
                  </div>
                ) : (
                  filteredComps.map((comp) => (
                    <div key={comp.id} style={{ padding: 14, borderRadius: 10, background: 'rgba(0,0,0,0.6)', border: '1px solid rgba(214,166,75,0.25)', display: 'grid', gap: 8 }}>
                      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start' }}>
                        <div>
                          <div style={{ fontSize: 13, color: '#fff', fontWeight: 600 }}>{comp.address}</div>
                          <div style={{ fontSize: 11, color: '#888', marginTop: 2 }}>{comp.distance} miles away • Built {comp.yearBuilt} • {comp.daysOnMarket} DOM</div>
                        </div>
                        <div style={{ textAlign: 'right' }}>
                          <div style={{ fontSize: 15, color: '#ebc477', fontWeight: 700 }}>${comp.salePrice.toLocaleString()}</div>
                          <div style={{ fontSize: 10, color: '#aaa' }}>${(comp.salePrice / comp.sqft).toFixed(0)}/sqft</div>
                        </div>
                      </div>
                      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', borderTop: '1px solid rgba(255,255,255,0.05)', paddingTop: 6, fontSize: 11, color: '#aaa' }}>
                        <span>{comp.beds} Bed / {comp.baths} Bath • {comp.sqft} SqFt</span>
                        <div style={{ display: 'flex', gap: 6 }}>
                          <span style={{ padding: '2px 6px', borderRadius: 4, background: 'rgba(214,166,75,0.15)', color: '#ebc477' }}>{comp.source}</span>
                          <span style={{ padding: '2px 6px', borderRadius: 4, background: 'rgba(50,205,50,0.15)', color: '#32CD32' }}>{comp.matchScore}% Match</span>
                        </div>
                      </div>
                    </div>
                  ))
                )}
              </div>
            </div>

            {/* Footer Summary */}
            <div style={{ borderTop: '1px solid rgba(214,166,75,0.2)', paddingTop: 16, display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
              <div>
                <div style={{ fontSize: 11, color: '#aaa' }}>Active Composite ARV</div>
                <div style={{ fontSize: 16, color: '#ebc477', fontWeight: 700 }}>${averageArv.toLocaleString(undefined, { maximumFractionDigits: 0 })}</div>
              </div>
              <ActionButton tone="gold" onClick={() => setIsDrawerOpen(false)}>Lock Comps & Close</ActionButton>
            </div>

          </div>
        </div>
      )}
    </PageShell>
  )
}
